# Copy to .env and fill in. Never commit .env.

# Twenty release to build on (see https://hub.docker.com/r/twentycrm/twenty/tags)
TWENTY_VERSION=v2.46.0

# Public address of the CRM
SERVER_URL=https://crm.opsknot.com

# Neon: Dashboard > Connect > turn OFF "Connection pooling", copy the URL.
# Keep ?sslmode=require at the end.
PG_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Generate once with: openssl rand -base64 32   (keep it safe; losing it locks stored secrets)
ENCRYPTION_KEY=

# Cloudflare Zero Trust > Networks > Tunnels > Create tunnel > copy the token
CLOUDFLARE_TUNNEL_TOKEN=

# Files: "local" keeps uploads on the VPS. For Cloudflare R2 set STORAGE_TYPE=s3 and fill these.
STORAGE_TYPE=local
# STORAGE_S3_REGION=auto
# STORAGE_S3_NAME=salesknot-files
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Outgoing email (invites, password resets). Optional for a demo.
# EMAIL_DRIVER=smtp
# EMAIL_FROM_ADDRESS=crm@opsknot.com
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
