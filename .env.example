# Copy to .env and fill in. Never commit .env.

# Twenty release to build on (see https://hub.docker.com/r/twentycrm/twenty/tags)
TWENTY_VERSION=v2.46.0

# Base address. Each CRM (workspace) gets its own subdomain: crm.salesknot.app, realestate.salesknot.app...
# Sign-in page: my.salesknot.app
SERVER_URL=https://salesknot.app
IS_MULTIWORKSPACE_ENABLED=true
DEFAULT_SUBDOMAIN=my

# Database. Default: SalesKnot's own Postgres container on this VPS (separate from any other Postgres).
# Generate the password with: openssl rand -hex 24   (letters/numbers only)
COMPOSE_PROFILES=localdb
DB_PASSWORD=
PG_DATABASE_URL=postgres://salesknot:${DB_PASSWORD}@db:5432/salesknot

# Alternative: Neon. Set COMPOSE_PROFILES= (empty) and use Neon's connection string
# (Dashboard > Connect > pooling OFF, keep ?sslmode=require):
# PG_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Generate once with: openssl rand -base64 32   (keep it safe; losing it locks stored secrets)
ENCRYPTION_KEY=

# Cloudflare Zero Trust > Networks > Tunnels > Create tunnel > copy the token
CLOUDFLARE_TUNNEL_TOKEN=

# Files: "local" keeps uploads on the VPS. For Cloudflare R2 set STORAGE_TYPE=s3 and fill these.
STORAGE_TYPE=local
# STORAGE_S3_REGION=auto
# STORAGE_S3_NAME=salesknot-files
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Outgoing email (invites, password resets). Optional for a demo.
# EMAIL_DRIVER=smtp
# EMAIL_FROM_ADDRESS=no-reply@salesknot.app
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# Social sign-in ("Continue with Google / Microsoft") on my.salesknot.app and every workspace.
# Only people who already belong to a workspace (or were invited) get in: new workspaces stay
# limited to the server admin, so the owner still approves every subdomain.
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application),
#   authorised redirect URI https://salesknot.app/auth/google/redirect
# AUTH_GOOGLE_ENABLED=true
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_CALLBACK_URL=https://salesknot.app/auth/google/redirect
# Microsoft: entra.microsoft.com > App registrations > New (any organisation + personal accounts),
#   Web redirect URI https://salesknot.app/auth/microsoft/redirect, then Certificates & secrets > New client secret
# AUTH_MICROSOFT_ENABLED=true
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_CALLBACK_URL=https://salesknot.app/auth/microsoft/redirect

# Demo bookings (the `demo` service, see demo/README.md). Uses the EMAIL_* settings above to send
# the 7-day magic links, so outgoing email must be set up (EMAIL_DRIVER=smtp) before taking bookings.
# Shared with the opsknot.com website's server; it sends: Authorization: Bearer <DEMO_API_SECRET>
# Generate each with: openssl rand -hex 32
DEMO_API_SECRET=
# Private to this server: derives the hidden passwords of demo visitors (never share it)
DEMO_SECRET_KEY=
# Address in the magic links (https://salesknot.app/demo/go/...)
PUBLIC_BASE_URL=https://salesknot.app
# How long a demo lasts (days)
DEMO_DAYS=7
# One SalesKnot account that is Admin in all four demo workspaces (core, call-centre, real-estate,
# travel-tours-and-visa). Create it with: docker compose exec demo node src/cli.mjs bootstrap <your-email> '<your-password>'
DEMO_ADMIN_EMAIL=demo-admin@opsknot.com
DEMO_ADMIN_PASSWORD=
# Each visitor gets an internal login like demo-visitors+sk-1a2b3c@opsknot.com. SalesKnot's own
# "Join your team" email for it lands in this mailbox (make it exist, or a filter that deletes them).
DEMO_VISITOR_MAILBOX=demo-visitors@opsknot.com
# Optional: Reply-To for the demo email
# DEMO_REPLY_TO=hello@opsknot.com
