# SalesKnot brand settings. Change these, then rebuild the image.
BRAND_NAME="SalesKnot"
BRAND_TAGLINE="The automation-first CRM"
BRAND_COMPANY="OpsKnot"
BRAND_WEBSITE="https://opsknot.com"
BRAND_DOCS_URL="https://opsknot.com"
BRAND_CONTACT_URL="https://opsknot.com/contact/"
# Domain the CRM runs on (used in examples such as "yourco.salesknot.app").
BRAND_APP_DOMAIN="salesknot.app"
# Public URL of your branded logo used inside emails (must be reachable from the internet).
BRAND_EMAIL_LOGO_URL="https://salesknot.app/images/icons/windows11/Square150x150Logo.scale-100.png"
# AGPL: where users can download the source of this modified version.
BRAND_SOURCE_URL="https://github.com/opsknot/salesknot"
# Legal links on the sign-in page ("By using SalesKnot, you agree to the Terms of Service ...").
BRAND_TERMS_URL="https://opsknot.com/terms/"
# Data Processing Agreement / privacy link on the sign-in page (Twenty's privacy links also point here).
BRAND_DPA_URL="https://opsknot.com/privacy-policy/"
